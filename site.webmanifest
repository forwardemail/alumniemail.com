{
  "name": "AlumniEmail",
  "short_name": "AlumniEmail",
  "description": "Lifetime alumni email forwarding for universities, from the Forward Email team.",
  "start_url": "/",
  "scope": "/",
  "display": "browser",
  "background_color": "#ffffff",
  "theme_color": "#1a365d",
  "icons": [
    {
      "src": "/images/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/images/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/images/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
